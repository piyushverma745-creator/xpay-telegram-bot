# Copy this file to .env and fill it in.

# Where this server is reachable from the internet: your ngrok static domain. No trailing slash.
PUBLIC_BASE_URL=https://YOUR-NGROK-DOMAIN

# Encrypts merchants' xPay keys in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it: if it changes, saved keys can't be decrypted and merchants must reconnect.
SECRET_KEY=

# --- Telegram ----------------------------------------------------------------------------
# Message @BotFather in Telegram, send /newbot, and paste the token it gives you here
# (or run: bash add-telegram.sh). No verification needed.
TELEGRAM_BOT_TOKEN=

# --- xPay --------------------------------------------------------------------------------------
# Sandbox only. The bot refuses to start with the live URL unless ALLOW_LIVE=true.
XPAY_BASE_URL=https://api.test.xpaycheckout.com
# Only used by chat.py (terminal mode). In the bot, merchants enter keys on the connect page.
XPAY_PUBLIC_KEY=
XPAY_PRIVATE_KEY=

# --- Optional ----------------------------------------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_EXPIRY_HOURS=168
TIMEZONE=Asia/Kolkata
DB_PATH=bot.db
# Creates a webhook on the merchant's xPay sandbox account when they connect, for payment alerts.
AUTO_REGISTER_XPAY_WEBHOOK=true
NOTIFY_CHECKOUT_OPENED=true
